rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phân hệ Quản lý Danh thiếp (Digital Business Card - Thành viên 2)
    match /users/{userId}/cards/{cardId} {
      // Chỉ chủ sở hữu tài khoản mới được đọc và ghi danh thiếp của mình
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Giới hạn dữ liệu hợp lệ khi tạo mới hoặc cập nhật
      allow create, update: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.cardName is string
        && request.resource.data.fullName is string
        && request.resource.data.company is string;
    }
  }
}
