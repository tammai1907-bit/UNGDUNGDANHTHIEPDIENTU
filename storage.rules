rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phân hệ Quản lý & Tải ảnh Danh thiếp (Thành viên 2)
    match /users/{userId}/cards/{cardId}/{allPaths=**} {
      // Cho phép công khai xem ảnh danh thiếp (để người quét thẻ/truy cập web xem được ảnh)
      allow read: if true;
      
      // Chỉ chủ sở hữu mới có quyền tải lên hoặc xóa ảnh của mình, giới hạn dung lượng dưới 5MB
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
